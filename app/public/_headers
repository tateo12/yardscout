# Never cache the HTML entrypoint or version file, so a normal reload always gets the latest deploy.
# (JS/CSS under /assets are content-hashed, so they're safe to cache forever.) Cloudflare Workers Assets honors this.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/version.json
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
